+// @spec RUNTIME-SHEETS-002
+#[test]
+fn view_marks_read_back_keeps_prior_quote_date_when_cell_unparseable() {
+    // The Quote Date formula cell can lag the Price cell by a poll (both are
+    // separate GOOGLEFINANCE calls on the same row): a settle-pass poll can see a
+    // freshly-numeric Price alongside a not-yet-recalculated Quote Date cell. The
+    // read-back keeps the symbol's last successfully-parsed quote date across
+    // polls rather than resetting the stamp to the epoch.
+    let fake = FakeSheetsApi::new();
+    fake.seed(
+        &format!("'{POS_TAB}'!A1:Z"),
+        vec![sheets_view::POSITIONS_HEADER
+            .iter()
+            .map(|s| s.to_string())
+            .collect()],
+    );
+    let mut row: Vec<String> = vec![String::new(); 13];
+    row[0] = "AMZN".to_string();
+    row[4] = "170.25".to_string();
+    row[12] = "19180".to_string();
+    fake.seed(&format!("'{POS_TAB}'!A2:Z"), vec![row]);
+    let adapter = ViewSheetsAdapter::new(fake, POS_TAB);
+
+    // First poll: the Quote Date cell parses; the read-back records Date(19_180).
+    let first = adapter.read_price_pass().expect("first poll");
+    match first.get("AMZN") {
+        Some(PriceReading::Numeric { quote_date, .. }) => {
+            assert_eq!(*quote_date, Date(19_180));
+        }
+        other => panic!("expected a numeric AMZN reading, got {other:?}"),
+    }
+
+    // Second poll: Price has re-settled to a new numeric value, but the Quote
+    // Date cell hasn't recalculated yet (empty).
+    let mut row2: Vec<String> = vec![String::new(); 13];
+    row2[0] = "AMZN".to_string();
+    row2[4] = "171.00".to_string();
+    adapter.api().seed(&format!("'{POS_TAB}'!A2:Z"), vec![row2]);
+    let second = adapter.read_price_pass().expect("second poll");
+    match second.get("AMZN") {
+        Some(PriceReading::Numeric {
+            price_usd,
+            quote_date,
+        }) => {
+            assert!((*price_usd - 171.00).abs() < 1e-9);
+            assert_eq!(
+                *quote_date,
+                Date(19_180),
+                "an unparseable Quote Date cell keeps the prior quote date, not the epoch"
+            );
+        }
+        other => panic!("expected a numeric AMZN reading, got {other:?}"),
+    }
+}
+
