+// @spec RUNTIME-SHEETS-002
+#[test]
+fn view_republish_writes_large_tabs_in_row_chunks() {
+    // A tab whose row count exceeds the write-chunk size rides multiple
+    // low-level updates (one per chunk) instead of one oversized update_range
+    // call; a tab at or under the chunk size still rides exactly one.
+    // (RUNTIME-SHEETS-002, SHEET-PUB-002)
+    use runtime::adapters::VIEW_WRITE_CHUNK_ROWS;
+
+    let make_tab = |rows: usize| ViewTab {
+        name: POS_TAB.to_string(),
+        header: sheets_view::POSITIONS_HEADER
+            .iter()
+            .map(|s| s.to_string())
+            .collect(),
+        rows: (0..rows)
+            .map(|i| vec![Cell::Value(format!("SYM{i}"))])
+            .collect(),
+    };
+
+    // Exactly one chunk's worth of rows: one update_range call.
+    let fake = FakeSheetsApi::new();
+    let mut adapter = ViewSheetsAdapter::new(fake, POS_TAB);
+    adapter
+        .batch_update_view(&make_tab(VIEW_WRITE_CHUNK_ROWS))
+        .expect("at-chunk-size republish");
+    assert_eq!(
+        adapter.api().update_count(),
+        1,
+        "a tab at the chunk size still rides one update_range call"
+    );
+
+    // One row over: a second chunk, a second update_range call.
+    let fake = FakeSheetsApi::new();
+    let mut adapter = ViewSheetsAdapter::new(fake, POS_TAB);
+    adapter
+        .batch_update_view(&make_tab(VIEW_WRITE_CHUNK_ROWS + 1))
+        .expect("over-chunk-size republish");
+    assert_eq!(
+        adapter.api().update_count(),
+        2,
+        "one row past the chunk size spills into a second update_range call"
+    );
+    let grid = adapter.api().rows_at(POS_TAB);
+    assert_eq!(
+        grid.len(),
+        VIEW_WRITE_CHUNK_ROWS + 1,
+        "every row is written across the chunk boundary"
+    );
+    assert_eq!(
+        grid[VIEW_WRITE_CHUNK_ROWS][0], "SYM500",
+        "the chunk boundary lands on the correct row"
+    );
+}
