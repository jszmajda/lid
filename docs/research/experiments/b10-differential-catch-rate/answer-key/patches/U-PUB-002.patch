+
+    /// Write a tab's data rows in successive row-anchored chunks of at most
+    /// [`VIEW_WRITE_CHUNK_ROWS`] rows, rather than one `update_range` call
+    /// carrying the whole grid — so an unusually large tab never rides a single
+    /// oversized write payload. Chunks are written in order starting from
+    /// [`sheets_view::DATA_START_ROW`]; the first chunk's anchored write is the
+    /// one that truncates the residual tail below it (SHEET-PUB-002), and each
+    /// later chunk continues exactly where the previous one left off.
+    fn write_data_rows(&self, name: &str, grid: &Grid) -> Result<(), SheetsError> {
+        if grid.is_empty() {
+            return self.api.update_range(&Self::data_range(name), grid);
+        }
+        for (i, chunk) in grid.chunks(VIEW_WRITE_CHUNK_ROWS).enumerate() {
+            let start_row = sheets_view::DATA_START_ROW + (i * VIEW_WRITE_CHUNK_ROWS) as u32;
+            let range = format!("'{name}'!A{start_row}:Z");
+            self.api.update_range(&range, &chunk.to_vec())?;
+        }
+        Ok(())
+    }
 }
 
