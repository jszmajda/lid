index 7e9df24..991ae7a 100644
--- a/crates/sheets-view/src/lib.rs
+++ b/crates/sheets-view/src/lib.rs
@@ -739,13 +739,19 @@ pub fn render_tax(accruals: &[Accrual], annual_rows: &[AnnualRow]) -> TaxView {
     // annual report (TAX-REPORT-003/004 → AnnualRow). (SHEET-FORMULA-004)
     let mut reserve_rows: Vec<ViewRow> = Vec::new();
     for r in annual_rows {
+        let row = (reserve_rows.len() as u32) + DATA_START_ROW;
+        // Outstanding = Accrued − Paid; this row's own cells already carry both,
+        // so it's wired the same row-anchored way as the Positions formulas
+        // rather than round-tripped as a second copy of the kernel figure
+        // (SHEET-FORMULA-002).
+        let outstanding = Cell::Formula(format!("={}-{}", cell_ref('C', row), cell_ref('E', row)));
         reserve_rows.push(vec![
             Cell::Value(jurisdiction_label(&r.jurisdiction)),
             Cell::Value(r.tax_year.0.to_string()),
             Cell::Value(fmt_cents(r.accrued_cents)),
             Cell::Value(fmt_cents(r.moved_cents)),
             Cell::Value(fmt_cents(r.paid_cents)),
-            Cell::Value(fmt_cents(r.outstanding_cents)),
+            outstanding,
             Cell::Value(fmt_cents(r.shortfall_cents)),
         ]);
     }
