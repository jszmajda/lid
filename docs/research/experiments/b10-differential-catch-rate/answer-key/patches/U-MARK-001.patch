+/// The pause before a settle-pass poll on this adapter instance: none on the
+/// first poll of a pass, then a small pause that doubles each poll after
+/// (50ms, 100ms, 200ms, …), capped at 400ms — so a still-recalculating
+/// `GOOGLEFINANCE` column isn't re-read on every tick of the settle loop.
+/// `poll_index` is 0-based (the count of polls already served).
+pub fn settle_poll_delay(poll_index: u32) -> std::time::Duration {
+    if poll_index == 0 {
+        return std::time::Duration::ZERO;
+    }
+    let shift = (poll_index - 1).min(3);
+    std::time::Duration::from_millis(50u64 << shift).min(std::time::Duration::from_millis(400))
+}
