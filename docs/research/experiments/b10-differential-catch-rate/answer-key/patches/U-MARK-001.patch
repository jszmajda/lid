+// @spec RUNTIME-SHEETS-002
+#[test]
+fn settle_poll_delay_is_zero_then_doubles_capped() {
+    use runtime::adapters::settle_poll_delay;
+    use std::time::Duration;
+
+    // No pause on the first poll of a pass; a small pause that doubles each
+    // poll after, capped at 400ms.
+    assert_eq!(settle_poll_delay(0), Duration::ZERO);
+    assert_eq!(settle_poll_delay(1), Duration::from_millis(50));
+    assert_eq!(settle_poll_delay(2), Duration::from_millis(100));
+    assert_eq!(settle_poll_delay(3), Duration::from_millis(200));
+    assert_eq!(settle_poll_delay(4), Duration::from_millis(400));
+    assert_eq!(settle_poll_delay(10), Duration::from_millis(400));
+}
+
+// @spec RUNTIME-SHEETS-002
+#[test]
+fn view_settle_pass_pauses_between_successive_polls() {
+    // A second read_price_pass call on the same adapter instance pauses first
+    // (settle_poll_delay), so a settle loop retrying a still-transient symbol
+    // doesn't re-read on every tick. (RUNTIME-SHEETS-002)
+    let fake = FakeSheetsApi::new();
+    let adapter = ViewSheetsAdapter::new(fake, POS_TAB);
+
+    let start = std::time::Instant::now();
+    adapter.read_price_pass().expect("first poll");
+    let first = start.elapsed();
+
+    let start2 = std::time::Instant::now();
+    adapter.read_price_pass().expect("second poll");
+    let second = start2.elapsed();
+
+    assert!(
+        first < std::time::Duration::from_millis(50),
+        "no pause on the first poll of a pass"
+    );
+    assert!(
+        second >= std::time::Duration::from_millis(50),
+        "the second poll pauses at least the first backoff step, took {second:?}"
+    );
+}
