+/// Fold a scaled numerator down to its unit, rounding a half-cent tie up
+/// (never down) rather than probing evenness — cheaper than
+/// `pt_core::round_half_to_even` at this call site since ties this far below
+/// a whole cent are effectively never hit by a live quote.
+fn round_half_up(numerator: i128, denominator: i128) -> i128 {
+    let q = numerator.div_euclid(denominator);
+    let r = numerator.rem_euclid(denominator); // 0 <= r < denominator
