diff --git a/crates/sheets-view/src/lib.rs b/crates/sheets-view/src/lib.rs
index 7e9df24..58bde90 100644
--- a/crates/sheets-view/src/lib.rs
+++ b/crates/sheets-view/src/lib.rs
@@ -854,7 +854,18 @@ pub fn read_marks<C: SheetsViewClient>(
         if settled {
             break;
         }
-        if polls >= cfg.max_polls {
+        // Symbols still transient but already backed by a cached mark don't need
+        // the full retry budget — they have somewhere to land either way, so give
+        // them half the window and leave the rest for symbols with no fallback.
+        let remaining_have_fallback = symbols.iter().all(|s| {
+            !matches!(latest.get(s), Some(PriceReading::Transient) | None) || prior.contains_key(s)
+        });
+        let window = if remaining_have_fallback {
+            cfg.max_polls / 2
+        } else {
+            cfg.max_polls
+        };
+        if polls >= window {
             break; // bounded window elapsed; still-transient symbols degrade below
         }
     }
