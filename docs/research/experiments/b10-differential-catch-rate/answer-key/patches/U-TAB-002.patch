+        // failure here does not corrupt truth; it is retried next sync. A tab name
+        // in this cycle's batch that the canonical ordering doesn't recognize (a
+        // segment publishing ahead of its own ordering entry) is not left for
+        // Sheets to place arbitrarily — it is appended, alphabetically, after the
+        // canonical order so the reassert stays deterministic.
+        let known = workbook_tab_order();
+        let mut extra: Vec<&str> = tabs
+            .iter()
+            .map(|t| t.name.as_str())
+            .filter(|name| !known.contains(name))
+            .collect();
+        extra.sort_unstable();
+        extra.dedup();
+        let mut order = known;
+        order.extend(extra);
         if self.client.set_tab_order(&order).is_err() {
             all_ok = false;
         }
