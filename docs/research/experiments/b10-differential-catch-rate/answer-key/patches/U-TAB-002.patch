+// @spec SHEET-TAB-002
+#[test]
+fn republish_appends_unrecognized_tabs_alphabetically_after_the_canonical_order() {
+    let client = InMemorySheetsView::new();
+    let mut pub_ = Publisher::new(client);
+
+    let positions = ViewTab {
+        name: POSITIONS_TAB.to_string(),
+        header: vec!["Symbol".to_string()],
+        rows: vec![],
+    };
+    // Two tabs outside the canonical ordering, published in a batch that also
+    // includes a known tab.
+    let zeta = ViewTab {
+        name: "Zeta Extra".to_string(),
+        header: vec!["A".to_string()],
+        rows: vec![],
+    };
+    let alpha = ViewTab {
+        name: "Alpha Extra".to_string(),
+        header: vec!["A".to_string()],
+        rows: vec![],
+    };
+    let _ = pub_.republish(&[positions, zeta, alpha], &NoopLock::new(), "2022-09-01");
+
+    let order = pub_.client().tab_order();
+    let expected: Vec<String> = workbook_tab_order().iter().map(|s| s.to_string()).collect();
+    assert_eq!(&order[..expected.len()], expected.as_slice());
+    // Unrecognized tabs land after the canonical order, alphabetically.
+    assert_eq!(
+        &order[expected.len()..],
+        &["Alpha Extra".to_string(), "Zeta Extra".to_string()]
+    );
+}
