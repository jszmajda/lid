 /// Resolve a ledger `Symbol` to its `GOOGLEFINANCE` ticker via `config`'s alias
 /// map (identity when unset). (SHEET-MAP-001)
+///
+/// The lookup key is trimmed of surrounding whitespace and upper-cased before
+/// the alias table is consulted, so a symbol that picked up incidental
+/// whitespace or lower-case letters on its way through import/entry still
+/// finds its alias instead of silently falling through to a raw-symbol
+/// identity ticker.
 pub fn resolve_ticker(aliases: &AliasMap, symbol: &str) -> String {
-    aliases.resolve(symbol)
+    let normalized = symbol.trim().to_uppercase();
+    aliases.resolve(&normalized)
 }
 
