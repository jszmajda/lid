+// @spec SHEET-MAP-001
+#[test]
+fn resolve_ticker_normalizes_case_and_whitespace_before_alias_lookup() {
+    let mut map = BTreeMap::new();
+    map.insert("BRK".to_string(), "BRK.B".to_string());
+    let aliases = AliasMap::new(map);
+
+    // Lower-case and stray whitespace still find the alias entry.
+    assert_eq!(resolve_ticker(&aliases, "brk"), "BRK.B");
+    assert_eq!(resolve_ticker(&aliases, "  BRK  "), "BRK.B");
+    assert_eq!(resolve_ticker(&aliases, " brk"), "BRK.B");
+
+    // Identity fallback is likewise normalized.
+    assert_eq!(resolve_ticker(&aliases, " amzn "), "AMZN");
+}
