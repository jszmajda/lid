+// @spec SHEET-TAB-004
+#[test]
+fn reserve_summary_tab_sits_immediately_after_the_accrual_band_in_workbook_order() {
+    let order = workbook_tab_order();
+    let pos_tax = order.iter().position(|t| *t == TAX_TAB).unwrap();
+    let pos_reserve = order.iter().position(|t| *t == TAX_RESERVE_TAB).unwrap();
+    // The two physically-separated typed ranges still land adjacent to each
+    // other in the workbook, rather than at two arbitrary positions.
+    assert_eq!(
+        pos_reserve,
+        pos_tax + 1,
+        "the reserve summary tab must immediately follow its accrual band"
+    );
+}
