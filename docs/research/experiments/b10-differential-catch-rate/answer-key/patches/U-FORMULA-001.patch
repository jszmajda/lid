+#[test]
+fn money_value_cells_carry_the_currency_number_format() {
+    let marks = common::marks(&[("AMZN", 200_00), ("GOOG", 140_00)]);
+    let snap = common::small_snapshot(&marks);
+    let ctx = common::ctx(2022);
+    let rates = common::effective_rates(&snap, Date(19_200), &ctx);
+    let aliases = AliasMap::default();
+    let positions = render_positions(&snap, &rates, &aliases).unwrap();
+
+    let row = &positions.rows[0];
+    for name in ["Avg Cost/Share", "Total Basis", "Realized P&L"] {
+        let cell = &row[col(name)];
+        assert_eq!(
+            cell.number_format(),
+            Some(sheets_view::CURRENCY_NUMBER_FORMAT),
+            "{name} must carry the currency number format: {cell:?}"
+        );
+    }
+
+    // Non-money cells (identifiers, quantities, and the live formulas) carry no
+    // explicit number format.
+    for name in ["Symbol", "Shares", "Est. Tax Rate", "Price"] {
+        assert_eq!(
+            row[col(name)].number_format(),
+            None,
+            "{name} should not carry a number format"
+        );
+    }
+}
