+/// The Sheets number-format pattern for an engine-written currency cell, so it
+/// renders as dollars regardless of the workbook's or viewer's locale default.
+pub const CURRENCY_NUMBER_FORMAT: &str = "$#,##0.00;-$#,##0.00";
+
+/// An engine-written money value, carrying [`CURRENCY_NUMBER_FORMAT`] alongside
+/// its formatted text.
+fn money_cell(c: Cents) -> Cell {
+    Cell::FormattedValue(fmt_cents(c), CURRENCY_NUMBER_FORMAT)
+}
