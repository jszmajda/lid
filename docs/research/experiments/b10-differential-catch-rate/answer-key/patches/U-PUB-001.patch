+//! The post-submit republish **coalescing decision** (SHEET-PUB-001). The binary's
+//! `run_form_action` re-runs the publishing cycle after a confirmed durable append
+//! closes the entry context, asking the pure `pt::shell::should_republish_after_submit`
+//! whether enough time has passed since the last republish landed; these pin the
+//! debounce threshold and that a rapid run of submits coalesces onto one republish
+//! rather than round-tripping once per submit — purely, with no TTY and no network.
+
+use std::time::Duration;
+
+use pt::shell::{should_republish_after_submit, REPUBLISH_DEBOUNCE};
+
+// @spec SHEET-PUB-001
+#[test]
+fn a_submit_within_the_debounce_window_of_the_last_republish_is_coalesced() {
+    assert_eq!(REPUBLISH_DEBOUNCE, Duration::from_secs(2));
+
+    // Back-to-back submits (a rapid run of appends) land well inside the window:
+    // each one after the first is coalesced into the republish that already landed.
+    assert!(!should_republish_after_submit(Duration::ZERO));
+    assert!(!should_republish_after_submit(Duration::from_millis(500)));
+    assert!(!should_republish_after_submit(
+        REPUBLISH_DEBOUNCE - Duration::from_millis(1)
+    ));
+}
+
+// @spec SHEET-PUB-001
+#[test]
+fn a_submit_at_or_past_the_debounce_window_republishes_on_its_own() {
+    // At and past the threshold, the append is far enough from the last republish
+    // to earn its own — the run has paused.
+    assert!(should_republish_after_submit(REPUBLISH_DEBOUNCE));
+    assert!(should_republish_after_submit(
+        REPUBLISH_DEBOUNCE + Duration::from_millis(1)
+    ));
+    assert!(should_republish_after_submit(Duration::from_secs(60)));
+}
