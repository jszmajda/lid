+/// How soon after a just-landed republish another submit-triggered one is
+/// coalesced into it rather than round-tripping again. (SHEET-PUB-001)
+pub const REPUBLISH_DEBOUNCE: Duration = Duration::from_secs(2);
+
+/// Whether a just-confirmed append should trigger its OWN immediate republish,
+/// given how long has elapsed since the last republish landed (SHEET-PUB-001).
+/// Within [`REPUBLISH_DEBOUNCE`] of the previous one, this append is coalesced
+/// into it — suppressed here, not dropped — rather than firing another
+/// round trip; a rapid run of submits (entering several trades back-to-back)
+/// settles the workbook once the run pauses, not once per submit. The next
+/// submit outside the window, a manual `[r]`, or the ambient hourly refresh
+/// still carries the coalesced append's data forward.
+pub fn should_republish_after_submit(elapsed_since_last_publish: Duration) -> bool {
+    elapsed_since_last_publish >= REPUBLISH_DEBOUNCE
+}
