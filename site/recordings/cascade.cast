[0.0, "o", "\r\n\u001b[1m\u001b[33m ❯ \u001b[39m\u001b[22mtests/trial.test.ts\u001b[2m [queued]\u001b[22m\r\n\r\n\u001b[2m Test Files \u001b[22m\u001b[1m\u001b[32m0 passed\u001b[39m\u001b[22m\u001b[90m (1)\u001b[39m\r\n\u001b[2m      Tests \u001b[22m\u001b[1m\u001b[32m0 passed\u001b[39m\u001b[22m\u001b[90m (0)\u001b[39m\r\n\u001b[2m   Start at \u001b[22m05:35:54\r\n\u001b[2m   Duration \u001b[22m0ms\r\n\u001b[?2026l"]
