[0.008081, "o", "\u001b[?2026h\u001b[?25l\u001b[2D\u001b[3B\r\u001b[2C\u001b[5A\u001b[1mGaps in the new end rule\r\u001b[1B\u001b[22m\u001b[K\r\u001b[1B\u001b[K\r\u001b[2B\u001b[38;5;246m❯ \u001b[39m\u001b[K\r\r\n\u001b[38;5;244m────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[3G\u001b[38;5;220m⏵⏵\u001b[6Gauto\u001b[11Gmode\u001b[16Gon\u001b[38;5;246m (shift+tab\u001b[30Gto\u001b[33Gcycle)\u001b[40G·\u001b[42G/tasks\u001b[49Gto\u001b[52Gsee\u001b[56Gsubagents\u001b[66G·\u001b[68Gesc\u001b[72Gto\u001b[75Ginterrupt\u001b[85G·\u001b[87G←\u001b[89G1\u001b[91Gagent\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?25h\u001b[?2026l"]
[0.008489, "o", "\u001b[?2026h\u001b[?25l\u001b[2D\u001b[3B\u001b[2K\u001b[G\u001b[1A\r\u001b[4A\u001b[38;5;244m────────────────────────────────────────────────────────────────────────────────────────────────────\r\u001b[1B\u001b[38;5;246m❯ \u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;244m────────────────────────────────────────────────────────────────────────────────────────────────────\r\u001b[1B\u001b[39m  \u001b[38;5;220m⏵⏵ auto mode on\u001b[38;5;246m (shift+tab to cycle) · /tasks to see subagents · esc to interrupt · ← 1 agent\u001b[39m\u001b[K\r\u001b[1B\u001b[K\u001b[2C\u001b[3A\u001b[?25h\u001b[?2026l"]
