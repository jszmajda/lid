[0.00555, "o", "\u001b[?2026h\u001b[?25l\u001b[2D\u001b[3B\r\u001b[11A\u001b[38;5;114m⏺\r\u001b[5C\u001b[2B\u001b[39m19:Every\u001b[15Guser\u001b[20Gtherefore\u001b[30Ggets\u001b[35Gat\u001b[38Gleast\u001b[44G30\u001b[47Gfull\u001b[52Gdays,\u001b[58Gand\u001b[62Gat\u001b[65Gmost\u001b[70Gone\u001b[74Gday\u001b[78Gmore.\u001b[84GThe\u001b[88Gend\u001b[92Gis\u001b[95Ga\r\u001b[6C\u001b[1Bcalendar\u001b[16Gdate\u001b[21Gin\u001b[24Gthe\u001b[28Guser's\u001b[35Gown\u001b[39Gzone,\u001b[45Gso\u001b[48Git\u001b[51Gcan\u001b[55Gbe\u001b[58Gtold\u001b[63Gto\u001b[66Gthem\u001b[71Gplainly\u001b[79G(\"your\u001b[86Gtrial\u001b[92Gruns\r\u001b[1B \u001b[3G    through March 31\").\u001b[27G\u001b[K\r\u001b[5C\u001b[1BUpdated \u001b[1mdocs/intent/trial/trial-design.md\u001b[22m \u001b[38;5;246m(+1\u001b[52G-1)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 16 \u001b[22m \r\u001b[1B\u001b[39m     \u001b[38;5;231m\u001b[2m 17 \u001b[22m The trial ends at midnight in the user's own time zone: the first local midnight at\u001b[39m\u001b[K\r\u001b[1B  \u001b[6G\u001b[38;5;231m\u001b[2m    \u001b[22m  or after 30 days from signup. A user who signs up in Tokyo at 11 p.m. on March 1 k\r\u001b[1B\u001b[39m     \u001b[38;5;231m\u001b[2m    \u001b[22m eeps the trial until 00:00 on April 1, Tokyo time, and so does one who signs up the\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;231m\u001b[2m    \u001b[22m re at 9 a.m. the same day.\u001b[39m\u001b[K\r\r\n\u001b[6G\u001b[38;5;231m\u001b[2m "]
[8.2e-05, "o", "18\u001b[10G\u001b[22m \u001b[39m\r\r\n\u001b[6G\u001b[38;5;167m\u001b[48;5;52m 19 -\u001b[38;5;231mEvery user therefore gets at least 30 full days, and at most one day more. The end \u001b[39m\u001b[49m\r\r\n\u001b[6G\u001b[38;5;167m\u001b[48;5;52m    -\u001b[38;5;231mis a calendar date in the user's own zone, so it can be told to them plainly (\"your\u001b[39m\u001b[49m\r\r\n\u001b[6G\u001b[38;5;167m\u001b[48;5;52m    -\u001b[38;5;231m trial ends at midnight, March 31\").                                               \u001b[39m\u001b[49m\r\r\n\u001b[6G\u001b[38;5;77m\u001b[48;5;22m 19 +\u001b[38;5;231mEvery user therefore gets at least 30 full days, and at most one day more. The end \u001b[39m\u001b[49m\r\r\n\u001b[6G\u001b[38;5;77m\u001b[48;5;22m    +\u001b[38;5;231mis a calendar date in the user's own zone, so it can be told to them plainly (\"your\u001b[39m\u001b[49m\r\r\n\u001b[6G\u001b[38;5;77m\u001b[48;5;22m    +\u001b[38;5;231m trial \u001b[48;5;28mruns\u001b[48;5;22m \u001b[48;5;28mthrough\u001b[48;5;22m March 31\").                                                    \u001b[49m\u001b[39m\r\r\n\u001b[6G\u001b[38;5;231m\u001b[2m 20\u001b[10G\u001b[22m \u001b[39m\r\r\n\u001b[6G\u001b[38;5;231m\u001b[2m 21\u001b[10G\u001b[22m ##\u001b[14GDecisions\u001b[24G&\u001b[26GAlternatives\u001b[39m\r\r\n\u001b[6G\u001b[38;5;231m\u001b[2m 22\u001b"]
