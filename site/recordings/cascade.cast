[0.035261, "o", "\u001b[?2026h\u001b[?25l\u001b[2D\u001b[3B\r\u001b[2C\u001b[5A────────────────────────────────────────\r\u001b[1B  \u001b[1m#:\u001b[22m 3\u001b[K\r\u001b[1B  \u001b[1mGap:\u001b[8GSome zones have no midnight on certain dates, or have it twice.\u001b[72G\u001b[22mThese\u001b[78Gare\u001b[82Gzones\u001b[88Gthat\u001b[93Gchange\r\u001b[1B    their clocks at 00:00.\u001b[K\r\u001b[2C\u001b[1B\u001b[1mMy recommendation:\u001b[22m Use \u001b[1mthe start of the local calendar day\u001b[22m instead of a literal 00:00. That's\u001b[97Gthe\r\r\n\u001b[5Gfirst\u001b[11Ginstant\u001b[19Gof\u001b[22Gthe\u001b[26Gdate,\u001b[32Gand\u001b[36Git's\u001b[41Galways\u001b[48Gdefined.\r\r\n\r\r\n\u001b[38;5;244m────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;5;246m❯ \u001b[39m\r\r\n\u001b[38;5;244m──────────────────────────────────"]
