[0.047019, "o", "\u001b[?2026h\u001b[?25l\u001b[2D\u001b[3B\r\u001b[35C\u001b[6A\u001b[38;5;220mth\u001b[39Gnking more with medium ef\u001b[65Gort\u001b[38;5;246m)\u001b[39m\u001b[K\r\r\n\r\n\r\n\r\n\r\n\r\n\u001b[2C\u001b[3A\u001b[?25h\u001b[?2026l"]
[0.042863, "o", "\u001b[?2026h\u001b[?25l\u001b[2D\u001b[3B\r\u001b[10A \u001b[3G\u001b[38;5;246mRead \u001b[1m1\u001b[22m file (ctrl+o to expand)\u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;231m⏺\u001b[3G\u001b[39m\u001b[1mPhase 1 (HLD check):\u001b[24G\u001b[22mThe\u001b[28GHLD\u001b[32Gdoesn't\u001b[40Gneed\u001b[45Gto\u001b[48Gchange.\u001b[56GIts\u001b[60Ggoal\u001b[65Gof\u001b[68G\"30\u001b[72Gdays\u001b[77Gfree\"\u001b[83Gand\u001b[87Gthe\u001b[91Gtenet\r\u001b[2C\u001b[1B\u001b[3mcustomer delight over perfect cost management\u001b[49G\u001b[23mboth\u001b[54Gstill\u001b[60Gapply.\u001b[67GThis\u001b[72Gchange\u001b[79Gbelongs\u001b[87Gto\u001b[90Gthe\u001b[94Gtrial\r\u001b[1B \u001b[3GLLD (\u001b[38;5;153mdocs/intent/trial/\u001b[39m). Right now that LLD ends the trial 720 hours\u001b[73Gafter\u001b[79Gsignup,\u001b[87Gand\u001b[91Gits\r\u001b[2C\u001b[1BDecisions\u001b[13Gtable\u001b[19Grejected\u001b[28Ga\u001b[30Gmidnight\u001b[39Gcutoff\u001b[46Gonly\u001b[51Gbecause\u001b[59Git\u001b[62Gused\u001b[67Gthe\u001b[71Gserver's\u001b[80Gtime\u001b[85Gzone.\u001b[91GUsing\u001b[97Gthe\r\u001b[1B  user's own time zone answers that objection. It does leave one decision open, and that decision\u001b[K\r\u001b[1B  affects\u001b[11Gthe\u001b[15Gtenet.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mPhase 2 needs your call first: which midnight?\u001b[22m The profile already stores\u001b[77Geach\u001b[82Guser's\u001b[89GIANA\u001b[94Gtime\r\r\n\u001b[3Gzone"]
[0.007654, "o", "\u001b[8Gfrom\u001b[13Gsignup,\u001b[21Gso\u001b[24Gthe\u001b[28Gopen\u001b[33Gquestion\u001b[42Gis\u001b[45Gonly\u001b[50Gwhich\u001b[56Gmidnight\u001b[65Gends\u001b[70Gthe\u001b[74Gtrial.\r\r\n\r\r\n\u001b[3G\u001b[1mA.\u001b[6GThe\u001b[10Gfirst\u001b[16Glocal\u001b[22Gmidnight\u001b[31Gat\u001b[34Gor\u001b[37Gafter\u001b[43G30\u001b[46Gdays\u001b[51G(recommended).\u001b[22m\r\r\n\u001b[3GSigning\u001b[11Gup\u001b[14GMar\u001b[18G1\u001b[20Gat\u001b[23G11\u001b[26Gp.m.\u001b[31Gin\u001b[34GTokyo\u001b[40Gends\u001b[45Gthe\u001b[49Gtrial\u001b[55Gat\u001b[58G00:00\u001b[64Gon\u001b[67GApr\u001b[71G1,\u001b[74GTokyo\u001b[80Gtime.\u001b[86GSigning\u001b[94Gup\u001b[97GMar\r\r\n\u001b[3G1\u001b[5Gat\u001b[8G9\u001b[10Ga.m.\u001b[15Galso\u001b[20Gends\u001b[25Git\u001b[28Gat\u001b[31G00:00\u001b[37Gon\u001b[40GApr\u001b[44G1.\r\r\n\u001b[3G-\u001b[5GEveryone\u001b[14Ggets\u001b[19Gat\u001b[22Gleast\u001b[28Gthe\u001b[32Gfull\u001b[37G30\u001b[40Gdays,\u001b[46Gplus\u001b[51Gup\u001b[54Gto\u001b[57Gone\u001b[61Gextra\u001b[67Gday.\r\r\n\u001b[3G-\u001b[5GThe\u001b[9Gtenet\u001b[15Gfavours\u001b[23Gthis:\u001b[29Gthe\u001b[33Gcost\u001b[38Gis\u001b[41Gat\u001b[44Gmost\u001b[49Ga\u001b[51Gday\u001b[55Gof\u001b[58Gfree\u001b[63Gaccess\u001b[70Gper\u001b[74Guser.\r\r\n\u001b[3G-\u001b[5GThe\u001b[9Gend\u001b[13Gdate\u001b[18Gis\u001b[21Geasy\u001b[26Gto\u001b[29Gtell\u001b[34Gpeople\u001b[41G(\"your\u001b[48Gtrial\u001b[54Gends\u001b[59Gat\u001b[62Gmidnight,\u001b[72GMarch\u001b[78G31\").\r\r\n\r\r\n\u001b[3G\u001b[1mB.\u001b[6GMidnight\u001b[15Gat\u001b[18Gthe\u001b[22Gend\u001b[26Gof\u001b[29Gthe\u001b[33G30th\u001b[38G"]
