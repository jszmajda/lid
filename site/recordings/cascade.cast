[0.16925, "o", "\u001b[?2026h\u001b[?25l\u001b[2D\u001b[3B\r\u001b[2C\u001b[3A/\r\u001b[2C\u001b[2B\u001b[38;5;153m❯ /linked-intent-dev:linked-intent-dev    (linked-intent-dev) Guide for linked-intent\u001b[39m\u001b[K\r\r\n\u001b[45G\u001b[38;5;153mdevelopment\u001b[57G(LID).\u001b[64GConsult\u001b[72Gfor\u001b[76GALL\u001b[80Gcode\u001b[85Gchanges.\u001b[94GWalk…\u001b[39m\r\r\n\u001b[3G\u001b[38;5;246m \u001b[5G/linked-intent-dev:update-lid\u001b[45G(linked-intent-dev)\u001b[65GConfigure\u001b[75Gor\u001b[78Greconcile\u001b[88Ga\u001b[90Gproject\u001b[39m\r\r\n\u001b[45G\u001b[38;5;246mfor\u001b[49Glinked-intent\u001b[63Gdevelopment\u001b[75G(LID).\u001b[82GDispatches\u001b[93Gon\u001b[96Gpr…\u001b[39m\r\r\n\u001b[3G\u001b[38;5;246m \u001b[5G/loop\u001b[45GRepeat\u001b[52Ga\u001b[54Gprompt\u001b[61Gor\u001b[64Gcommand\u001b[72Gon\u001b[75Gan\u001b[78Ginterval\u001b[87G(e.g.\u001b[93G/loop\u001b[39m\r\r\n\u001b[45G\u001b[38;5;246m5m\u001b[48G/foo)\u001b[39m\r\r\n\u001b[3G\u001b[38;5;246m \u001b[5G/linked-intent-dev:lid-coach\u001b[45G(linked-intent-dev)\u001b[65GReview\u001b[72Ga\u001b[74Gproject's\u001b[84Gcurrent\u001b[39m\r\r\n\u001b[45G\u001b[38;5;246mlinked-intent-development\u001b[71G(LID)\u001b[77Gusage\u001b[83Gagainst\u001b[91GLID's\u001b[97Go…\u001b[39m\r\r\n\u001b[3G\u001b[38;5;246m \u001b[5G/claude-api\u001b[45GBuild\u001b[51Gand\u001b[55Gdebug\u001b[61Gapps\u001b[66Gthat\u001b[71Guse\u001b[75Gthe\u001b[79GClaude\u001b[86GAPI\u001b[39m\r\r\n\u001b[3G\u001b[38;5;246m \u001b[5G/a"]
