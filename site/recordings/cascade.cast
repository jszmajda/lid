[0.024344, "o", "\u001b[?2026h\u001b[?25l\u001b[2D\u001b[3B\r\u001b[7A\u001b[38;5;231m⏺\u001b[3G\u001b[39m\u001b[1mPhase 3: the trial specs (\u001b[38;5;153mdocs/intent/trial/trial-specs.md\u001b[39m)\r\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;5;153m[x]\u001b[9G\u001b[39m\u001b[1mTRIAL-001\u001b[22m:\u001b[20GWhen\u001b[25Ga\u001b[27Gnew\u001b[31Guser\u001b[36Gsigns\u001b[42Gup,\u001b[46Gthe\u001b[50Gsystem\u001b[57Gshall\u001b[63Gstart\u001b[69Ga\u001b[71Gtrial.\u001b[78G\u001b[3m(unchanged)\r\u001b[1B\u001b[23m  - \u001b[38;5;153m[ ]\u001b[39m \u001b[1mTRIAL-002\u001b[22m: While the current time is before the trial's stored end time, the system shall\u001b[K\r\u001b[1B  \u001b[5Ggive\u001b[10Gthe\u001b[14Guser\u001b[19Gfull\u001b[24Gaccess.\u001b[32G\u001b[3m(changed: it now uses the stored end time instead of signup + 720 \r\u001b[1B\u001b[23m    \u001b[3mhours)\u001b[23m\u001b[K\r\u001b[2C\u001b[1B- \u001b[38;5;153m[ ]\u001b[39m \u001b[1mTRIAL-003\u001b[22m: When the current time reaches or passes the trial's\u001b[72Gstored\u001b[79Gend\u001b[83Gtime,\u001b[89Gthe\u001b[93Gsystem\r\r\n\u001b[5Gshall\u001b[11Gend\u001b[15Gthe\u001b[19Gtrial.\u001b[26G\u001b[3m(changed)\u001b[23m\r\r\n\u001b[3G-\u001b[5G\u001b[38;5;153m[\u001b[7G]\u001b[9G\u001b[39m\u001b[1mTRIAL-004\u001b[22m:\u001b[20GWhen\u001b[25Ga\u001b[27Gtrial\u001b[33Gstarts,\u001b[41Gthe\u001b[45Gsystem\u001b[52Gshall\u001b[58Gset\u001b[62Gthe\u001b[66Gtrial's\u001b[74Gend\u001b[78Gtime\u001b[83Gto\u001b[86Gthe\u001b[90Gstart"]
[0.00029, "o", "\u001b[96Gof\r\r\n\u001b[5Gthe\u001b[9Gfirst\u001b[15Gcalendar\u001b[24Gday,\u001b[29Gin\u001b[32Gthe\u001b[36Guser's\u001b[43Grecorded\u001b[52Gtime\u001b[57Gzone,\u001b[63Gthat\u001b[68Gbegins\u001b[75Gat\u001b[78Gor\u001b[81Gafter\u001b[87G720\u001b[91Gelapsed\r\r\n\u001b[5Ghours\u001b[11Gfrom\u001b[16Gsignup.\u001b[24G\u001b[3m(new)\u001b[23m\r\r\n\u001b[3G-\u001b[5G\u001b[38;5;153m[\u001b[7G]\u001b[9G\u001b[39m\u001b[1mTRIAL-005\u001b[22m:\u001b[20GWhen\u001b[25Ga\u001b[27Gtrial\u001b[33Gstarts,\u001b[41Gthe\u001b[45Gsystem\u001b[52Gshall\u001b[58Gstore\u001b[64Gthe\u001b[68Gtrial's\u001b[76Gend\u001b[80Gtime\u001b[85Gon\u001b[88Gthe\u001b[92Gtrial.\r\r\n\u001b[5G\u001b[3m(new)\u001b[23m\r\r\n\u001b[3G-\u001b[5G\u001b[38;5;153m[\u001b[7G]\u001b[9G\u001b[39m\u001b[1mTRIAL-006\u001b[22m:\u001b[20GIf\u001b[23Gthe\u001b[27Guser's\u001b[34Gtime\u001b[39Gzone\u001b[44Gchanges\u001b[52Gafter\u001b[58Ga\u001b[60Gtrial\u001b[66Ghas\u001b[70Gstarted,\u001b[79Gthe\u001b[83Gsystem\u001b[90Gshall\u001b[96Gkeep\r\r\n\u001b[5Gthe\u001b[9Gtrial's\u001b[17Gstored\u001b[24Gend\u001b[28Gtime\u001b[33Gunchanged.\u001b[44G\u001b[3m(new)\u001b[23m\r\r\n\u001b[3G-\u001b[5G\u001b[38;5;153m[\u001b[7G]\u001b[9G\u001b[39m\u001b[1mTRIAL-007\u001b[22m:\u001b[20GIf\u001b[23Gthe\u001b[27Guser's\u001b[34Grecorded\u001b[43Gtime\u001b[48Gzone\u001b[53Gis\u001b[56Gmissing\u001b[64Gor\u001b[67Gis\u001b[70Gnot\u001b[74Ga\u001b[76Gvalid\u001b[82GIANA\u001b[87Gtime\u001b[92Gzone\r\r\n\u001b[5Gname,\u001b[11Gthen\u001b[16Gthe\u001b[20Gsystem\u001b[27Gshall\u001b[33Gcompute\u001b[41Gthe\u001b[45Gtrial's\u001b[53Gend\u001b[57Gtime\u001b[62Gin"]
