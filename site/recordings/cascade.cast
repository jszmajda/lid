[0.013223, "o", "\u001b[?2026h\u001b[?25l\u001b[2D\u001b[3B\r\u001b[2C\u001b[5A────────────────────────────────────────\r\u001b[1B  \u001b[1m#:\u001b[22m 5\u001b[K\r\u001b[1B  \u001b[1mGap:\u001b[8GWhether the time zone is fixed at signup.\u001b[50G\u001b[22mThe\u001b[54GLLD\u001b[58Gdoesn't\u001b[66Gsay\u001b[70Gwhether\u001b[78Gtravelling\u001b[89Gor\u001b[92Gediting\r\u001b[1B    the profile moves the end.\u001b[K\r\u001b[2C\u001b[1B\u001b[1mMy recommendation:\u001b[22m \u001b[1mFixed at signup.\u001b[22m Then the end can't drift, and users can't extend the trial\u001b[98Gby\r\r\n\u001b[5Gchanging\u001b[14Gzones.\r\r\n\r\r\n\u001b[38;5;244m────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;5;246m❯ \u001b[39m\r\r\n\u001b[38;5;244m──────────────────────────────────────────────────"]
