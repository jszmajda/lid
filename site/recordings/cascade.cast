[0.0, "o", " \u001b[32m✓\u001b[39m tests/trial.test.ts \u001b[2m(\u001b[22m\u001b[2m13 tests\u001b[22m\u001b[2m)\u001b[22m\u001b[32m 20\u001b[2mms\u001b[22m\u001b[39m\r\n   \u001b[32m✓\u001b[39m starts a trial when a new user signs up\u001b[32m 11\u001b[2mms\u001b[22m\u001b[39m\r\n   \u001b[32m✓\u001b[39m gives full access until the stored end time, and not at it\u001b[32m 1\u001b[2mms\u001b[22m\u001b[39m\r\n   \u001b[32m✓\u001b[39m ends the trial once the current time reaches the stored end time\u001b[32m 0\u001b[2mms\u001b[22m\u001b[39m\r\n   \u001b[32m✓\u001b[39m ends a Tokyo trial at the start of the first Tokyo day after 720 hours (LLD worked example)\u001b[32m 1\u001b[2mms\u001b[22m\u001b[39m\r\n   \u001b[32m✓\u001b[39m ends a morning signup at the same local midnight as a late-evening one\u001b[32m 0\u001b[2mms\u001b[22m\u001b[39m\r\n   \u001b[32m✓\u001b[39m ends exactly 720 hours after a signup at a local day start\u001b[32m 0\u001b[2mms\u001b[22m\u001b[39m\r\n   \u001b[32m✓\u001b[39m counts 720 elapsed hours, not 30 calendar days, across a spring-forward\u001b[32m 1\u001b[2mms\u001b[22m\u001b[39m\r\n   \u001b[32m✓\u001b[39m ends at the first instant of the local day when that day has no 00:00\u001b[32m 1\u001b[2mms\u001b[22m\u001b[39m\r\n   \u001b[32m✓\u001b[39m stores the end time on the trial when it starts\u001b[32m"]
[0.0, "o", " 1\u001b[2mms\u001b[22m\u001b[39m\r\n   \u001b[32m✓\u001b[39m keeps the stored end time when the user's time zone changes after the trial starts\u001b[32m 1\u001b[2mms\u001b[22m\u001b[39m\r\n   \u001b[32m✓\u001b[39m computes the end in Etc/GMT+12 when the time zone is missing\u001b[32m 1\u001b[2mms\u001b[22m\u001b[39m\r\n   \u001b[32m✓\u001b[39m computes the end in Etc/GMT+12 when the time zone is empty\u001b[32m 1\u001b[2mms\u001b[22m\u001b[39m\r\n   \u001b[32m✓\u001b[39m computes the end in Etc/GMT+12 when the time zone is not an IANA name\u001b[32m 1\u001b[2mms\u001b[22m\u001b[39m\r\n\r\n\u001b[2m Test Files \u001b[22m \u001b[1m\u001b[32m1 passed\u001b[39m\u001b[22m\u001b[90m (1)\u001b[39m\r\n\u001b[2m      Tests \u001b[22m \u001b[1m\u001b[32m13 passed\u001b[39m\u001b[22m\u001b[90m (13)\u001b[39m\r\n\u001b[2m   Start at \u001b[22m 05:35:54\r\n\u001b[2m   Duration \u001b[22m 109ms\u001b[2m (transform 41%, tests 41%, import 14%, worker 4%)\u001b[22m\r\n\r\n"]
