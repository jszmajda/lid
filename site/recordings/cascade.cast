[0.044403, "o", "\u001b[?2026h\u001b[?25l\u001b[2D\u001b[3B\r\u001b[2C\u001b[5A────────────────────────────────────────\r\u001b[1B  \u001b[1m#:\u001b[22m 8\u001b[K\r\u001b[1B  \u001b[1mGap:\u001b[8GA signup exactly at local midnight.\r\u001b[1B\u001b[22m  \u001b[1mMy recommendation:\u001b[22m It ends exactly 30 days later. This is the one case with no extra time, and\u001b[K\r\u001b[2C\u001b[1Bit's\u001b[K\r\r\n\u001b[5Gfine\u001b[10Gas\u001b[13Gis.\r\r\n\r\r\n\r\r\n\u001b[38;5;244m────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;5;246m❯ \u001b[39m\r\r\n\u001b[38;5;244m───────────────────────────────────────────────────────────────────────────────────────────"]
