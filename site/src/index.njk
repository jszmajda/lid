      <h1 class="pitch">
        How do you know your agent built what you <em>meant</em>?
      </h1>

      <ol class="framing" aria-label="Four-line framing">
        {% for line in site.framing %}
          <li>{{ line | safe }}</li>
        {% endfor %}
