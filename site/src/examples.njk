---
layout: base.njk
title: Examples
eleventyNavigation:
  key: Examples
  order: 3
permalink: /examples/
description: Projects built with Linked-Intent Development, each with its intent tree drawn out and the story of how it was built.
---

<!-- @spec ONB-SHOWCASE-001, ONB-SHOWCASE-002, ONB-SITE-068 -->
{% macro picture(e) %}
  {%- if e.pictures.length %}<img src="/examples/{{ e.slug }}/{{ e.pictures[0].file }}" alt="{{ e.pictures[0].alt }}" loading="lazy">
  {%- else %}{{ e.drawing.svg | safe }}{% endif -%}
{% endmacro %}
{% macro body(e) %}
  <p class="kicker"><span>{{ e.project }}</span> · {{ e.date | showcaseDate }}{% if e.size %} <span class="size">{{ e.size }}</span>{% endif %}</p>
  <h2><a href="/examples/{{ e.slug }}/">{{ e.story.title if e.story else e.project }}</a></h2>
  <p class="by">{{ e.credit }}</p>
  <p class="teaser">{{ e.tagline }}</p>
  {% if e.stats.length %}<ul class="facts">{% for s in e.stats.slice(0, 3) %}<li>{{ s[0] }}: {{ s[1] }}</li>{% endfor %}</ul>{% endif %}
  <p class="where"><a href="/examples/{{ e.slug }}/">Read more <span class="ptr" aria-hidden="true"></span></a> <span class="muted">· {{ "Open source" if e.open_source else "Code private" }}</span></p>
{% endmacro %}
<div class="page wrap">

  <header class="page-head">
    <h1>People are building very different things with LID.</h1>
    <p class="lede">
      A desktop written in days. A game its owner never read the code of. A tax tracker whose arithmetic is proven. A journal app well into its second year. Each project has a page here with its intent tree drawn out, and a link to the story of how it was built.
    </p>
  </header>

  <!-- @spec ONB-SHOWCASE-003, ONB-SHOWCASE-004, ONB-SHOWCASE-005, ONB-SHOWCASE-006, ONB-SHOWCASE-007, ONB-SHOWCASE-008, ONB-SHOWCASE-013, ONB-SHOWCASE-014 -->
  {% if examples.featured %}{% set f = examples.featured %}
  <article class="node feature">
    <a class="feature-thumb{% if not f.pictures.length %} is-tree{% endif %}" href="/examples/{{ f.slug }}/" tabindex="-1" aria-hidden="true">{{ picture(f) }}</a>
    <div class="feature-body">{{ body(f) }}</div>
  </article>
  {% endif %}

  <div class="story-grid">
    {% for e in examples.rest %}
    <article class="node story">
      <a class="story-thumb{% if not e.pictures.length %} is-tree{% endif %}" href="/examples/{{ e.slug }}/" tabindex="-1" aria-hidden="true">{{ picture(e) }}</a>
      <div class="story-body">{{ body(e) }}</div>
    </article>
    {% endfor %}
  </div>

  <!-- @spec ONB-SHOWCASE-009, ONB-SHOWCASE-010, ONB-SHOWCASE-011 -->
  <section class="sec-sm" id="whole-tree" aria-labelledby="whole-tree-heading">
    <h2 class="h2-sm" id="whole-tree-heading">Read a whole tree</h2>
    <div class="ref-grid">
      {% for r in examples.references %}
      <a class="node ref" href="{{ r.href }}">
        <div class="ref-thumb">{{ r.drawing.svg | safe }}</div>
        <div>
          <h3>{{ r.title }} <span class="ptr" aria-hidden="true"></span></h3>
          <p class="ref-sentence">{{ r.sentence }}</p>
          <p class="facts-line">{{ r.total | commas }} specs · {{ r.docs | commas }} design docs · {{ r.size }}</p>
        </div>
      </a>
      {% endfor %}
    </div>
  </section>

  <!-- @spec ONB-SHOWCASE-012 -->
  <aside class="node epilogue" aria-labelledby="add-heading">
    <h2 id="add-heading">Built something with LID? Add it here.</h2>
    <p>Open a pull request that adds one folder: a short entry, a screenshot or two, and your intent tree's shape, which one script writes for you. Bring your story to host here, or link to it where it already lives. Private projects are welcome: we show only what you choose, and your tree can go without its names.</p>
    <p><a class="btn btn-ghost" href="{{ site.repoUrl }}/blob/main/CONTRIBUTING.md#share-a-project-you-built">How to add your project</a></p>
  </aside>

</div>
