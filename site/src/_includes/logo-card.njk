<article class="logo-card" id="logo-{{ logo.slug }}" data-logo="{{ logo.name }}">
  <div class="logo-tile">{% include "logo-ideas/" + logo.slug + ".svg" %}</div>
  <h3>{{ logo.name }}</h3>
  <p class="logo-idea">{{ logo.idea | safe }}</p>
  <fieldset class="logo-switch">
    <legend>Palette for {{ logo.name }}</legend>
    {%- for palette in logo.palettes %}
    <label><input type="radio" name="palette-{{ logo.slug }}" value="{{ palette.letter }}"{% if loop.first %} checked{% endif %}><span class="logo-chip"><span class="logo-chip-colors" style="background:{{ palette.chip }}"></span>{{ palette.upper }}</span></label>
    {%- endfor %}
  </fieldset>
  <div class="logo-label-row">
    <p class="logo-label">
      {%- for palette in logo.palettes -%}
      <span data-palette="{{ palette.letter }}">{{ logo.name }}, palette {{ palette.upper }}</span>
      {%- endfor -%}
    </p>
  </div>
</article>
