<!-- @spec MKT-SITE-019, MKT-SITE-020, MKT-SITE-125, MKT-SITE-127, MKT-SITE-128 -->
{% set navLinks = [
  { label: "Start", href: "/start/" },
  { label: "Examples", href: "/examples/" },
  { label: "Anti-patterns", href: "/anti-patterns/" },
  { label: "Tour", href: "/tour/" },
  { label: "GitHub", href: site.repoUrl }
] %}
<header class="nav-bar" id="nav-bar">
  <div class="wrap nav">
    <a class="home" href="{{ '/' | url }}" aria-label="LID home">{% include "wordmark.svg" %}</a>
    <nav aria-label="Primary">
      <ul class="nav-links">
        {%- for item in navLinks %}
        <li><a href="{{ item.href | url }}"{% if page.url == item.href %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {%- endfor %}
      </ul>
    </nav>
    <a class="btn btn-go nav-install" href="{{ '/#quickstart' | url }}">Install</a>
    <details class="nav-menu">
      <summary><span class="menu-bars" aria-hidden="true"></span>Menu</summary>
      <ul>
        {%- for item in navLinks %}
        <li><a href="{{ item.href | url }}"{% if page.url == item.href %} aria-current="page"{% endif %}>{{ item.label }} <span class="ptr" aria-hidden="true"></span></a></li>
        {%- endfor %}
      </ul>
    </details>
  </div>
</header>
