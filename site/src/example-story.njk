---
layout: base.njk
pagination:
  data: examples.mdStories
  size: 1
  alias: e
permalink: "/examples/{{ e.slug }}/story/"
eleventyComputed:
  title: "{{ e.story.title }}"
  description: "{{ e.tagline }}"
  socialImage: "{{ ('/examples/' + e.slug + '/' + e.pictures[0].file) if e.pictures.length else '' }}"
  socialImageAlt: "{{ e.pictures[0].alt if e.pictures.length else '' }}"
  socialImageWidth: "{{ e.pictures[0].width if e.pictures.length else '' }}"
  socialImageHeight: "{{ e.pictures[0].height if e.pictures.length else '' }}"
eleventyExcludeFromCollections: true
---

<!-- @spec ONB-SHOWCASE-024, ONB-SHOWCASE-028 -->
<div class="page wrap">
  <p class="crumb"><a href="/examples/">Examples</a> <span class="ptr" aria-hidden="true"></span> <a href="/examples/{{ e.slug }}/">{{ e.project }}</a> <span class="ptr" aria-hidden="true"></span></p>
  <article class="post">
    <h1>{{ e.story.title }}</h1>
    <p class="by">{{ e.story.byline }} · {{ e.date | showcaseDate }}</p>
    <div class="prose">{{ e.storyMarkdown | markdown | safe }}</div>
  </article>
</div>
